#!/bin/bash
# Integration tests for the nixunits CLI.
#
# Run as root on a systemd host with nixunits installed (NixOS or portable).
# Usage: nixunits_tests [-d] [-s <first step>]
set -euo pipefail

ID="nixunits-test"
PRIVATE_HOST_IP4="10.0.1.1/31"
PRIVATE_IP4="10.0.1.0/31"
PRIVATE_HOST_IP6="fc00::d:e:f:1/127"
PRIVATE_IP6="fc00::d:e:f:0/127"

STEP=0
while getopts "ds:" opt; do
  case $opt in
    d) set -x;;
    s) STEP=$OPTARG;;
    *) echo "Usage: $0 [-d] [-s step]" >&2; exit 1;;
  esac
done

NIXUNITS=_NIXUNITS_PATH_SED_/bin/nixunits
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

_fail() { echo " ! ! ! ERROR - $* ! ! !" >&2; exit 1; }

_field() { "$NIXUNITS" status "$ID" "${@:2}" | jq -r ".$1"; }

_assert_field() {
  local field="$1" expected="$2" got
  shift 2
  got=$(_field "$field" "$@")
  [ "$got" = "$expected" ] || _fail "status.$field: expected '$expected', got '$got'"
}

_ping() {
  local opt=() n
  [[ "$1" == *:* ]] && opt=(-6)
  for n in 1 2 3 4 5; do
    ping "${opt[@]}" -c 1 -w 5 "$1" >/dev/null && return 0
    sleep "$n"
  done
  _fail "ping $1"
}

_step() {
  if [ "$STEP" -le "$1" ]; then
    echo " = = = Step $1 : $2 = = ="
  else
    return 1
  fi
}

cat > "$WORK/config.nix" <<'EOF'
{ lib, properties, ... }: let
  get = path: default: lib.attrByPath path default properties;
in {
  caps_allow = [ "CAP_NET_BIND_SERVICE" ];
  network.interfaces.veth = {
    ip4 = get [ "ip4" ] "";
    hostIp4 = get [ "hostIp4" ] "";
    ip6 = get [ "ip6" ] "";
    hostIp6 = get [ "hostIp6" ] "";
  };
  config = {
    services.httpd.enable = true;
    system.stateVersion = "25.11";
  };
}
EOF
sed 's/httpd.enable = true/httpd.enable = false/' "$WORK/config.nix" > "$WORK/config2.nix"

jq -n --arg id "$ID" --arg ip4 "$PRIVATE_IP4" --arg h4 "$PRIVATE_HOST_IP4" \
  '{id: $id, ip4: $ip4, hostIp4: $h4}' > "$WORK/params4.json"
jq -n --arg id "$ID" --arg ip4 "$PRIVATE_IP4" --arg h4 "$PRIVATE_HOST_IP4" \
  --arg ip6 "$PRIVATE_IP6" --arg h6 "$PRIVATE_HOST_IP6" \
  '{id: $id, ip4: $ip4, hostIp4: $h4, ip6: $ip6, hostIp6: $h6}' > "$WORK/params46.json"

[ "$(_field in_nixos)" = true ] && _fail "$ID is declared in NixOS"

"$NIXUNITS" delete "$ID" -f -r >/dev/null 2>&1 || true
_assert_field status initial

if _step 0 "invalid ids are rejected"; then
  for bad in "../x" "a/b" "-x" 'a$(id)' ""; do
    if "$NIXUNITS" status "$bad" >/dev/null 2>&1; then
      _fail "id '$bad' accepted"
    fi
  done
fi

if _step 1 "build"; then
  "$NIXUNITS" build -n "$WORK/config.nix" -j "$WORK/params4.json" >/dev/null
  _assert_field status created
  _assert_field need_switch true
  _assert_field started false
fi

if _step 2 "start (switch)"; then
  "$NIXUNITS" start "$ID" -s >/dev/null
  _assert_field status started
  _assert_field started true
  _assert_field need_switch false
  _assert_field os nixos
  _ping "${PRIVATE_IP4%/*}"
fi

if _step 3 "change detection"; then
  _assert_field need_store_build false -n "$WORK/config.nix" -j "$WORK/params4.json"
  _assert_field need_container_build false -n "$WORK/config.nix" -j "$WORK/params4.json"
  _assert_field need_container_build true -n "$WORK/config.nix" -j "$WORK/params46.json"
  _assert_field need_store_build true -n "$WORK/config2.nix"
fi

if _step 4 "rebuild without -n (reuse config) + restart with IPv4/IPv6"; then
  "$NIXUNITS" build -j "$WORK/params46.json" -r >/dev/null
  _assert_field status started
  _ping "${PRIVATE_IP4%/*}"
  _ping "${PRIVATE_IP6%/*}"
fi

if _step 5 "restart"; then
  "$NIXUNITS" restart "$ID" >/dev/null
  _assert_field status started
  _ping "${PRIVATE_IP4%/*}"
fi

if _step 6 "delete"; then
  "$NIXUNITS" delete "$ID" -f -r >/dev/null
  _assert_field status initial
  _assert_field started false
fi

echo " = = = TESTS OK  = = = "
