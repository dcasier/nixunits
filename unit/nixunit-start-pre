#!/bin/bash
set -eo pipefail
trap 'echo -e "!!!!\n!!!! Error on $LINENO line : $BASH_COMMAND\n!!!!" >&2' ERR

ID=$1
# shellcheck disable=SC1091
. _NIXUNITS_PATH_SED_/bin/common.sh

export PATH=$PATH:_OPENVSWITCH_PATH_SED_/bin
id_check "$ID"
UNIT_DIR=$(unit_dir "$ID")
UID_ROOT=$(uid_root "$ID")
MAX_UID=$(( UID_ROOT + 65535 ))

interface_check() {
  interface_env "$1"
  if ! interface_exists "$INTERFACE" && [ -n "$OVS_BRIDGE" ] ; then
    if ovs_port_exists "$INTERFACE" true; then
      if [ -n "$OVS_BRIDGE" ]; then
        ovs_port_del "$INTERFACE"
      fi
    fi
    if [ -n "$OVS_BRIDGE" ]; then
      log_msg "Create OVS interface - $INTERFACE - "
      ovs_port_add "$INTERFACE"
    fi
  fi
  if [ "$MV" != "" ]; then
    if ! ip link show "$MV" >/dev/null 2>&1; then
      ip link add "$MV" link "$INTERFACE" type macvlan mode bridge
    fi
    ip link set "$MV" addrgenmode random
      if [ -n "$MV_VRID" ]; then
        ip link set dev "$MV" address "$(printf "00:00:5e:00:02:%02x" "$MV_VRID")"
      fi
  fi
}

owner_fix() {
    local dst="$1" src="$2"
    local root="$UNIT_DIR/root"
    local rest="${dst#/}" cur="" comp link uid target hops=0

    # Walk the destination component by component. Symlinks found under the
    # container root are resolved *inside* that root (as nspawn does for the
    # bind itself), never on the host: e.g. /var/run -> /run must give
    # root/run, not the host's /run.
    while [ -n "$rest" ]; do
        comp="${rest%%/*}"
        if [ "$comp" = "$rest" ]; then rest=""; else rest="${rest#*/}"; fi
        case "$comp" in
            ""|.) continue;;
            ..) cur="${cur%/*}"; continue;;   # can't climb above the root
        esac

        if [ -z "$rest" ]; then
          target="$src"
        else
          if [ -L "$root$cur/$comp" ]; then
            hops=$((hops + 1))
            if [ "$hops" -gt 40 ]; then
              log_msg "ERROR: too many symlinks in bind destination $dst"
              exit 1
            fi
            link=$(readlink "$root$cur/$comp")
            case "$link" in /*) cur="";; esac
            rest="${link#/}/$rest"
            continue
          fi
          cur="$cur/$comp"
          target="$root$cur"
        fi
        uid=$(stat -c '%u' "$target" 2>/dev/null || echo -1)
        if (( uid < UID_ROOT || uid > MAX_UID )); then
            log_msg "chown $UID_ROOT:$UID_ROOT $target"
            mkdir -p "$target"
            chown "$UID_ROOT":"$UID_ROOT" "$target"
        fi
    done
}

###############################################################################
# Main
###############################################################################

log_block_msg "### nixunits START PRE"

for iface in $(interfaces_list); do
  interface_check "$iface"
done

for arg_ in $NSPAWN_ARGS; do
    case "$arg_" in
        --bind=*)
            val="${arg_#--bind=}"

            if [[ "$val" == *:* ]]; then
                src="${val%%:*}"
                dst="${val#*:}"
                dst="${dst%%:*}" # strip options (SRC:DST:ro)
            else
                src="$val"
                dst="$val"
            fi

            owner_fix "$dst" "$src"
            ;;
    esac
done

log_msg "### nixunits END PRE ###"