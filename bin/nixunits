#!/bin/bash
set -e

. _NIXUNITS_PATH_SED_/bin/common.sh

usage() {
  echo "Usage : nixunits action [options]"
  echo
  echo "Available actions:"
  echo "  build"
  echo "  delete"
  echo "  disable"
  echo "  enable"
  echo "  gc"
  echo "  ip6_get <container name>"
  echo "  list"
  echo "  nsenter|shell"
  echo "  start"
  echo "  restart|reboot <id> [-f]"
  echo "  status"
  echo "  version"
  echo "  stop <id> [-f]"
  echo "  * : wrapper => machinectl \$@"
  echo "  h, help"
  echo "  <action> h, help"
  echo

  test -n "$1" && exit "$1"
  exit 0
}

ACTION="$1"
test -z "$ACTION" && machinectl && exit 0
test "$ACTION" = "-h" && usage 0
test "$ACTION" = "--help" && usage 0
shift

case "$ACTION" in
  build)
    _NIXUNITS_PATH_SED_/bin/build.sh "$@";;
  delete)
    _NIXUNITS_PATH_SED_/bin/delete.sh "$@";;
  disable)
    _NIXUNITS_PATH_SED_/bin/disable.sh "$@";;
  enable)
    if grep -q '^ID=nixos' /etc/os-release; then
      echo "WARNING: on NixOS, enable is runtime only (/run/systemd/system): lost at reboot." >&2
      echo "         After a reboot, start with 'nixunits start <id>' (not systemctl, the network" >&2
      echo "         would not be configured), or declare the container in the NixOS configuration." >&2
    fi
    _NIXUNITS_PATH_SED_/bin/enable.sh "$@";;
  gc)
    _NIXUNITS_PATH_SED_/bin/gc.sh "$@";;
  ip6_get)
    ip6_crc32 "$1";;
  list)
    echo "Exists : "
    ls -1 /var/lib/nixunits/containers
    echo
    echo "=> machinectl list"
    machinectl list
    ;;
  nsenter|shell)
    _NIXUNITS_PATH_SED_/bin/nsenter.sh "$@";;
  restart|reboot)
    _NIXUNITS_PATH_SED_/bin/start.sh "$@" -r;;
  start)
    _NIXUNITS_PATH_SED_/bin/start.sh "$@";;
  status)
    _NIXUNITS_PATH_SED_/bin/status.sh "$@";;
  stop)
    _NIXUNITS_PATH_SED_/bin/stop.sh "$@";;
  version|--version)
    echo "nixunits $NIXUNITS_VERSION ($NIXUNITS_REV)";;
  h|help)
    usage 0;;
  *)
    # shellcheck disable=SC2068
    machinectl "$ACTION" $@;;
esac
